# Generate locally, for example: openssl rand -hex 32
# Supply via your shell environment or an untracked .env file.
JWT_SECRET=

# Separate worker-to-gateway secret; generate independently from JWT_SECRET.
FANOUT_TOKEN=

# Optional backend process environment (container use requires explicit forwarding).
CHORDS_KAFKA_BROKERS=kafka:9092
# Compatibility only; default WS sends use synchronous backend acceptance.
CHORDS_LEGACY_COMMANDS=0
